{%- assign coll = section.settings.collection -%}
<section class="section{% if section.settings.neutral_bg %} section--neutral{% endif %}">
  <div class="page-width">
    <div class="section-head">
      <h2 class="section-head__title">{{ section.settings.heading }}</h2>
      <div style="display:flex; align-items:center; gap:18px;">
        {%- if coll != blank and section.settings.show_view_all -%}
          <a href="{{ coll.url }}" class="section-head__link">View all</a>
        {%- endif -%}
        <div class="rail-arrows">
          <button type="button" class="rail-arrow" data-rail-prev aria-label="Previous">{% render 'icon', name: 'arrow-left' %}</button>
          <button type="button" class="rail-arrow" data-rail-next aria-label="Next">{% render 'icon', name: 'arrow-right' %}</button>
        </div>
      </div>
    </div>

    {%- if coll != blank and coll.products.size > 0 -%}
      <div class="rail-wrap" data-rail-wrap>
        <div class="rail" data-rail>
          {%- for product in coll.products limit: section.settings.limit -%}
            {% render 'product-card', card_product: product, badge: section.settings.badge %}
          {%- endfor -%}
        </div>
      </div>
    {%- else -%}
      <p style="color:#6f6a60">Select a collection in the theme editor to show products here.</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Product rail",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best sellers" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "min": 4, "max": 12, "step": 1, "label": "Products to show", "default": 8 },
    { "type": "text", "id": "badge", "label": "Badge label (optional)" },
    { "type": "checkbox", "id": "show_view_all", "label": "Show View all link", "default": true },
    { "type": "checkbox", "id": "neutral_bg", "label": "Neutral background", "default": false }
  ],
  "presets": [{ "name": "Product rail" }]
}
{% endschema %}
