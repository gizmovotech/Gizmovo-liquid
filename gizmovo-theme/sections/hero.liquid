{%- assign fallback = 'https://images.pexels.com/photos/4127608/pexels-photo-4127608.jpeg' -%}
<section class="hero{% if section.settings.dark_text %} hero--dark{% endif %}">
  <div class="hero__media">
    {%- if section.settings.image -%}
      <img src="{{ section.settings.image | image_url: width: 2200 }}"
           srcset="{{ section.settings.image | image_url: width: 800 }} 800w, {{ section.settings.image | image_url: width: 1400 }} 1400w, {{ section.settings.image | image_url: width: 2200 }} 2200w"
           sizes="100vw" alt="{{ section.settings.image.alt | escape | default: section.settings.heading }}" width="2200" height="1400" fetchpriority="high">
    {%- else -%}
      <img src="{{ fallback }}" alt="{{ section.settings.heading }}" width="2200" height="1400" fetchpriority="high">
    {%- endif -%}
    <div class="hero__content">
      <div class="page-width">
        <div class="hero__inner">
          {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
          <h1 class="hero__title">{{ section.settings.heading }}</h1>
          {%- if section.settings.text != blank -%}<p class="hero__text">{{ section.settings.text }}</p>{%- endif -%}
          <div class="hero__actions">
            {%- if section.settings.button_label != blank -%}
              <a href="{{ section.settings.button_link }}" class="btn">{{ section.settings.button_label }}</a>
            {%- endif -%}
            {%- if section.settings.link_label != blank -%}
              <a href="{{ section.settings.link_url }}" class="text-link">{{ section.settings.link_label }}</a>
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "New season" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Gear that keeps up." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Charging, audio and carry essentials, chosen carefully and built to last." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the range" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "link_label", "label": "Secondary link label", "default": "See best sellers" },
    { "type": "url", "id": "link_url", "label": "Secondary link URL" },
    { "type": "checkbox", "id": "dark_text", "label": "Use dark text (for light images)", "default": false }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
