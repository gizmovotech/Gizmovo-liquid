<section class="section">
  <div class="page-width">
    <div class="newsletter">
      <h2 class="newsletter__title">{{ section.settings.heading }}</h2>
      <p class="newsletter__text">{{ section.settings.text }}</p>
      {%- form 'customer', class: 'newsletter__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {%- if form.posted_successfully? -%}
          <p class="newsletter__note" style="width:100%">{{ 'general.newsletter.success' | t }}</p>
        {%- else -%}
          <input type="email" name="contact[email]" placeholder="you@email.com" required aria-label="Email">
          <button type="submit" class="btn">{{ section.settings.button_label }}</button>
        {%- endif -%}
      {%- endform -%}
      {%- if section.settings.note != blank -%}<p class="newsletter__note">{{ section.settings.note }}</p>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get first access." },
    { "type": "text", "id": "text", "label": "Text", "default": "New drops and restocks, straight to your inbox. No spam." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Subscribe" },
    { "type": "text", "id": "note", "label": "Note", "default": "One or two emails a month. Unsubscribe anytime." }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
