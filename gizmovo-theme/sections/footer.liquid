<footer class="footer">
  <div class="page-width">
    <div class="footer__top">
      <div class="footer__brand">
        <div class="footer__wordmark">{{ section.settings.wordmark | default: shop.name }}</div>
        <p class="footer__blurb">{{ section.settings.blurb }}</p>
        <div class="footer__socials">
          {%- if settings.social_instagram != blank -%}<a href="{{ settings.social_instagram }}" aria-label="Instagram">{% render 'icon', name: 'instagram' %}</a>{%- endif -%}
          {%- if settings.social_twitter != blank -%}<a href="{{ settings.social_twitter }}" aria-label="X">{% render 'icon', name: 'twitter' %}</a>{%- endif -%}
          {%- if settings.social_youtube != blank -%}<a href="{{ settings.social_youtube }}" aria-label="YouTube">{% render 'icon', name: 'youtube' %}</a>{%- endif -%}
        </div>
      </div>

      {%- for block in section.blocks -%}
        <div class="footer__col" {{ block.shopify_attributes }}>
          <h4>{{ block.settings.heading }}</h4>
          {%- if block.settings.menu != blank -%}
            {%- for link in block.settings.menu.links -%}
              <a href="{{ link.url }}">{{ link.title }}</a>
            {%- endfor -%}
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    <div class="footer__bottom">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</span>
      <span>{{ section.settings.tagline }}</span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "text", "id": "wordmark", "label": "Wordmark text", "default": "Gizmovo" },
    { "type": "textarea", "id": "blurb", "label": "Brand blurb", "default": "Considered tech accessories for people who move fast. Built to last, priced fairly." },
    { "type": "text", "id": "tagline", "label": "Bottom tagline", "default": "Designed in India." }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        { "type": "menu" },
        { "type": "menu" },
        { "type": "menu" }
      ]
    }
  ]
}
{% endschema %}
